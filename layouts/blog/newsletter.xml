{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>New posts from {{ site.Title }}</description>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with .OutputFormats.Get "newsletter" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range first 10 .RegularPagesRecursive.ByDate.Reverse }}
    {{- $page := . }}
    {{- $body := .Params.social.newsletter | default .Params.summary | default (.Summary | plainify) }}
    {{- $html := "" }}
    {{- with partial "funcs/social_image.html" $page }}
      {{- $alt := $page.Params.image_alt | default "" | plainify | htmlEscape }}
      {{- $html = printf "<img src=\"%s\" alt=\"%s\" width=\"800\" style=\"max-width:100%%;height:auto\">" .Permalink $alt }}
    {{- end }}
    {{- range split (trim $body "\n ") "\n\n" }}
      {{- $html = printf "%s<p>%s</p>" $html (htmlEscape .) }}
    {{- end }}
    {{- $html = printf "%s<p><a href=\"%s\">Read the full post</a></p>" $html $page.Permalink }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- range .Params.tags }}
      <category>{{ . }}</category>
      {{- end }}
      <description>{{ $html | transform.XMLEscape | safeHTML }}</description>
      <content:encoded>{{ $html | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
